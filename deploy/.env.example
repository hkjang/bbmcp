# bbmcp 배포 환경변수 예시.
# cp deploy/.env.example deploy/.env 로 복사한 뒤 값을 채우십시오.

# 이미지 태그 (bbmcp:v<버전>)
BBMCP_VERSION=0.2.10

# 서비스 노출 포트
BBMCP_PORT=8080

# PostgreSQL
POSTGRES_USER=bbmcp
POSTGRES_PASSWORD=
POSTGRES_DB=bbmcp

# 최초 관리자 계정 (관리 콘솔 로그인용)
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 저장되는 모든 비밀값을 암호화하는 32바이트 키.
# 생성 예: openssl rand -base64 32
# 분실하면 저장된 Client Secret, 서비스 PAT, 사용자 PAT 을 복호화할 수 없습니다.
ENCRYPTION_KEY=
